rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Store settings (restaurant hours, status, pix info)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Menu catalog items
    match /menu/{menuId} {
      allow read: if true;
      allow write: if true;
    }

    // Customer orders
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    // Delivery neighborhoods & rates
    match /neighborhoods/{neighborhoodId} {
      allow read: if true;
      allow write: if true;
    }

    // Discount coupons
    match /coupons/{couponId} {
      allow read, write: if true;
    }
  }
}
